# Obligatorio solo para sincronizar con Google Workspace.
GOOGLE_SERVICE_ACCOUNT_FILE=/ruta/absoluta/service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEET_ID=
# Pestaña que recibirá los datos. Use "Hoja 1" para la primera pestaña predeterminada de Sheets.
GOOGLE_SHEET_TAB=Iniciativas

# Opcional: el portal oficial exige este token de reCAPTCHA v3 para PDFs.
# Debe obtenerse de manera legítima para cada ejecución; no se almacena.
CONGRESO_CAPTCHA_TOKEN=

# Operación
MONITOR_DB_PATH=data/monitor.sqlite3
MONITOR_DOWNLOAD_DIR=downloads
MONITOR_TOPICS_PATH=config/topics.json
MONITOR_LOOKBACK_DAYS=7
MONITOR_PAGE_SIZE=50
MONITOR_TIMEOUT_SECONDS=30
MONITOR_MAX_RETRIES=3
MONITOR_LOG_LEVEL=INFO
